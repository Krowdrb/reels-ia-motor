[
  {"id": "l01", "text": "Pedro pregunta: «¿Perdono siete veces?»", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "Y Jesús responde:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02b", "text": "«No siete, sino setenta veces siete».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Pierdo la cuenta…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03b", "text": "y él cuenta una historia.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Un siervo debe al rey", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04b", "text": "diez mil talentos:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "una deuda imposible de pagar.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "De rodillas, suplica:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06b", "text": "«Ten paciencia conmigo».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "El rey, compadecido,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07b", "text": "le perdona toda la deuda.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "Al salir, el perdonado agarra del cuello", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08b", "text": "a un compañero que le debe cien denarios:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "unos cien días de trabajo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "«Págame».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10b", "text": "Y lo echa a la cárcel.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "El rey: «¿No debías tener compasión, como yo de ti?»", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "Enojado, lo entrega a los carceleros.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "Perdonar no es contar:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13b", "text": "es recordar cuánto te perdonaron.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14", "text": "¿A quién perdonas hoy?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
