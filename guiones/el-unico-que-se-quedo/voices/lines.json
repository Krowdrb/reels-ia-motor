[
  {"id": "l01", "text": "María estaba al pie de la cruz…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "y de los discípulos, solo uno aparece con ella.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Yo estaba ahí, a un lado.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "asr": "La noche anterior, en Getsemani,", "text": "La noche anterior, en Getsemaní,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "todos lo dejaron y huyeron.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Ahora, junto a la cruz, estaban su madre,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "la hermana de su madre,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "asr": "María de Cleofas y María Magdalena.", "text": "María de Cleofás y María Magdalena.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "Y uno más: el discípulo a quien él amaba.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Y Jesús los vio a los dos.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Mujer, he ahí tu hijo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "Y al discípulo: he ahí tu madre.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "Desde aquella hora, la recibió en su casa.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14", "text": "En su hora más oscura, pensó en ella.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l15", "text": "¿Quién se quedó contigo?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
