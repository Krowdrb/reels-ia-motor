[
  {"id": "l01", "text": "Cuatro sueños tuvo José, el esposo de María…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "y los evangelios no guardan ni una palabra suya.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Estoy en su taller, en Nazaret.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "María espera un hijo,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04b", "text": "y aún no viven juntos.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "Él es justo…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05b", "text": "y piensa dejarla en secreto.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Primer sueño.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06b", "text": "Un ángel: no temas recibir a María.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Despierta, y hace lo que el ángel le mandó.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "Segundo sueño: huye a Egipto", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08b", "text": "con el niño y su madre.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "De noche, se van.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Tercero: vuelve a Israel.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Cuarto: un aviso…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11b", "text": "y se van a Galilea, a Nazaret.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "Ni una palabra.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12b", "text": "Cuatro veces, se levantó.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "¿Cuál sueño te costaría más?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
