[
  {"id": "l01", "text": "Tres hombres pasarán junto a este herido.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l01b", "text": "¿Cuál se detendrá?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "Estoy en una parábola de Jesús.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Un maestro de la ley preguntó:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03b", "text": "¿quién es mi prójimo?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Un hombre bajaba a Jericó,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04b", "text": "casi mil metros cuesta abajo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "Ladrones lo despojaron, lo hirieron", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05b", "text": "y lo dejaron medio muerto.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Un sacerdote lo vio… y pasó por el otro lado.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Un levita, igual.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "Llegó un samaritano.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "Lo vio… y tuvo compasión.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Lo vendó con aceite y vino,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10b", "text": "lo subió a su cabalgadura", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10c", "text": "y lo cuidó en un mesón.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Pagó dos denarios; prometió pagar lo demás.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "Y Jesús preguntó: ¿cuál fue el prójimo?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12b", "text": "El que tuvo misericordia.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "Ve, y haz tú lo mismo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13b", "text": "Mirar no basta.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14", "text": "¿Quién es tu prójimo hoy?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14b", "text": "Dilo en una palabra.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
