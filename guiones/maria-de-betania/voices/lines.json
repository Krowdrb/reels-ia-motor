[
 {
  "id": "l01",
  "text": "Este frasco valía casi un año de trabajo…",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l01b",
  "text": "y ella lo rompió.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l02",
  "text": "Estoy en Betania, seis días antes de la Pascua.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l03",
  "text": "Marta sirve. Lázaro cena con Jesús.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l04",
  "text": "María derrama nardo puro en sus pies",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l05",
  "text": "y los seca con su cabello.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l06",
  "text": "La casa se llena del perfume.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l07",
  "text": "Pero Judas protesta:",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l08",
  "text": "pudo venderse en trescientos denarios, para los pobres.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l09",
  "text": "Lo decía porque tenía la bolsa… y robaba.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l10",
  "text": "«Déjala», responde Jesús.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l11",
  "text": "Lo guardó para su sepultura.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l12",
  "text": "A los pobres siempre los tendrán.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l12b",
  "text": "A él, no siempre.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l14",
  "text": "Y dondequiera que se anuncie el evangelio,",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l14b",
  "text": "se contará lo que ella hizo.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l15",
  "text": "Lo que das con amor nunca se desperdicia.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l18",
  "text": "¿Qué le darías tú a Jesús?",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l18b",
  "text": "Dilo en una palabra.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 }
]