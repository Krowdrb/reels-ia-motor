[
  {"id": "l01", "text": "Vi a Salomón componer tres mil proverbios…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l01b", "text": "¿y aun así se desvió?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "En Gabaón, Dios le dijo en sueños:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03b", "text": "Pide lo que quieras.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "No pidió riquezas.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04b", "text": "Pidió un corazón entendido.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "Y Dios se lo dio.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Tres mil proverbios.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06b", "text": "Mil cinco cantares.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Siete años construyendo el templo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "Trece años, su propio palacio.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "Pero tuvo setecientas esposas", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09b", "text": "y trescientas concubinas.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "En su vejez,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10b", "text": "ellas inclinaron su corazón tras otros dioses.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Levantó altares en el monte frente a Jerusalén.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "Su corazón ya no era completo con Dios.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "En sus Proverbios se lee:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13b", "text": "sobre todo, guarda tu corazón.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14", "text": "Tu corazón se cuida cada día.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l15", "text": "Si Dios te dijera «pide»…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l15b", "text": "¿qué pedirías? Dilo en una palabra.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
