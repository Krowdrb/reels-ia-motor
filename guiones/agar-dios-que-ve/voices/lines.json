[
  {"id": "l01", "text": "Agar huyó sola al desierto…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l01b", "text": "y alguien la llamó por su nombre.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "Yo caminaba con ella.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "La afligía Sarai, su señora.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "En una fuente, la halló el ángel del Señor.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "«Agar, ¿de dónde vienes?»", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "«Tu hijo se llamará Ismael»:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06b", "text": "Dios oye.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Ella lo llamó «el Dios que me ve».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "Años después, Abraham la despidió con pan y agua.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "Ya sin agua, dejó al niño bajo un arbusto", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09b", "text": "y se sentó a un tiro de arco:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "«No quiero ver morir al niño».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Pero Dios oyó la voz del niño.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "Le abrió los ojos…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12b", "text": "y vio un pozo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "Nadie la veía.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13b", "text": "Dios, sí.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14", "text": "A ti también te ve.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l15", "text": "¿Tú cómo llamarías a Dios?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
