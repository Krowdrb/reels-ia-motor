[
 {
  "id": "l01",
  "text": "Pedro y Judas le fallaron a Jesús la misma noche…",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l01b",
  "text": "y solo uno volvió.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l02",
  "text": "Estoy junto a este fuego.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l03",
  "text": "Antes, Judas lo entregó con un beso…",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l04",
  "text": "por treinta monedas.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l05",
  "text": "Ahora una criada mira a Pedro:",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l05b",
  "text": "«Tú también estabas con él».",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l06",
  "text": "«No lo conozco».",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l06b",
  "text": "Tres veces.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l07",
  "text": "Cantó el gallo.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l08",
  "text": "El Señor se volvió… y miró a Pedro.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l09",
  "text": "Pedro salió y lloró amargamente.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l10",
  "text": "También Judas, arrepentido, devolvió las monedas…",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l11",
  "text": "salió del templo… y no volvió.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l12",
  "text": "Días después, Jesús esperaba en la orilla",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l13",
  "text": "con brasas encendidas.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l14",
  "text": "Tres veces le preguntó a Pedro: «¿Me amas?»",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l15",
  "text": "Y tres veces: «Apacienta mis ovejas».",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l16",
  "text": "Si fallaste, vuelve:",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l16b",
  "text": "el fuego sigue encendido.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l17",
  "text": "¿Qué le responderías tú a Jesús?",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l17b",
  "text": "Dilo en una palabra.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 }
]