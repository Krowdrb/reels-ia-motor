[
 {
  "id": "l01",
  "text": "Unos cuarenta autores de la Biblia… y yo junto a uno.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l02",
  "text": "¿En cuánto tiempo?",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l03",
  "text": "Unos mil quinientos años.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l05",
  "text": "En tres idiomas: hebreo,",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l06",
  "text": "arameo, aquí en Babilonia, en Daniel,",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l07",
  "text": "y griego, el Nuevo Testamento.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l08",
  "text": "Los capítulos llegaron en el siglo trece.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l09",
  "text": "Los versículos, en el dieciséis.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l10",
  "text": "El capítulo más largo, el Salmo ciento diecinueve:",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l11",
  "text": "ciento setenta y seis versículos.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l12",
  "text": "El más corto, el ciento diecisiete: solo dos.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l13",
  "text": "Y el versículo más corto, en muchas Biblias…",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l14",
  "asr": "Aquí en Betania Jesús lloro",
  "text": "Aquí, en Betania: «Jesús lloró».",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l16",
  "text": "Quitaron la piedra de la tumba.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l17",
  "asr": "Luego clamó Lazaro ven fuera",
  "text": "Luego clamó: «¡Lázaro, ven fuera!».",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l18",
  "text": "Y salió, con las vendas puestas.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l19",
  "text": "Sus lágrimas no fueron el final.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l20",
  "text": "Si hoy lloras, no lloras solo.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 },
 {
  "id": "l21",
  "text": "Si esto te dio esperanza, escribe AMÉN.",
  "voice": "ef_dora",
  "speed": 1.0,
  "lang": "es-419"
 }
]