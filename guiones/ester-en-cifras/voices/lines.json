[
  {"id": "l01", "text": "Ester es reina de un imperio de ciento veintisiete provincias…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l01b", "text": "y no puede ver al rey.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "Estoy con ella en Susa.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Quien entra sin ser llamado, muere…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03b", "text": "salvo que el rey extienda el cetro de oro.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Y a ella no la llaman hace treinta días.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "Y hay un decreto contra todo su pueblo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Mardoqueo le manda decir:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06b", "text": "¿quién sabe si para esta hora llegaste al reino?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Ella pide tres días de ayuno.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07b", "text": "Yo los cuento a su lado.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07c", "text": "«Y si perezco, que perezca.»", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "Al tercer día se viste de reina…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08b", "text": "y entra.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "El rey extiende el cetro de oro…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09b", "text": "y Ester toca la punta.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Ciento veintisiete, treinta, tres…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10b", "text": "y al final, un solo gesto.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Quizás tú también llegaste para esta hora.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "¿Cuál es tu hora?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12b", "text": "Dilo en una palabra.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
