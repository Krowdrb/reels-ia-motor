[
  {"id": "l01", "text": "Lázaro llevaba cuatro días en esta tumba…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "y Jesús lloró antes de llamarlo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Yo estaba en Betania.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Le avisaron que su amigo estaba enfermo…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "y aun así, esperó.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "A Marta le dijo:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Yo soy la resurrección y la vida.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "María lloraba a sus pies.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "Y Jesús lloró.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Aun sabiendo lo que haría.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Quiten la piedra, dijo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "Marta dudó: ya huele mal, son cuatro días.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "Él alzó los ojos y dio gracias al Padre.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14", "text": "¡Lázaro, ven fuera!", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l15", "text": "Y salió, atado de manos y pies.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l16", "text": "Desátenlo y déjenlo ir.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l17", "text": "Lloró antes de llamarlo… y también llora contigo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l18", "text": "¿Qué piedra le pides que quite?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
