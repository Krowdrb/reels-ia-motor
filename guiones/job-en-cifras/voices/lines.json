[
  {"id": "l01", "text": "Estoy contando ovejas con Job. ¡Siete mil!", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l01b", "text": "Mañana no quedará ni una.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "Y tres mil camellos.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Pero en un solo día llegaron mensajeros.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Ovejas, camellos… todo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "Y un viento derribó la casa de sus hijos.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Él se postró y adoró.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06b", "text": "«El Señor dio, el Señor quitó.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06c", "text": "Bendito sea su nombre».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Llegaron sus amigos.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07b", "text": "Y se sentaron con él una semana entera.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "Nadie dijo nada.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08b", "text": "Yo tampoco.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "Esta historia no terminó ahí.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Después de orar por sus amigos,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10b", "text": "el Señor le devolvió el doble.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10c", "text": "Ahora: catorce mil ovejas, seis mil camellos.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Y vivió ciento cuarenta años más.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "Y si hoy lo pierdes todo,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12b", "text": "no estás solo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "¿Qué te sostiene en tu peor día?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13b", "text": "Dilo en una palabra.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
