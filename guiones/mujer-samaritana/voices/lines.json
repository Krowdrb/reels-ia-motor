[
  {"id": "l01", "text": "Él nunca la había visto…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l01b", "text": "¿cómo sabía toda su vida?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "Estoy en el pozo de Jacob.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Mediodía. Jesús, cansado, se sienta.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Llega una samaritana.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "«Dame de beber», le pide.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Se extraña: judíos y samaritanos no se tratan.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "«Si supieras quién te pide…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07b", "text": "le pedirías agua viva».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "«Ve, llama a tu marido».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "«No tengo marido».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "«Cinco has tenido,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10b", "text": "y el de ahora no lo es».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Él le habla de adorar en espíritu y en verdad.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "«Sé que viene el Mesías», dice ella.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "«Yo soy, el que habla contigo».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14", "text": "Deja el cántaro. Corre al pueblo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l15", "text": "«¡Vengan a ver! Me dijo todo».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l16", "text": "Muchos creyeron.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l17", "text": "Él conoce tu vida…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l17b", "text": "y no se aparta.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l18", "text": "¿Qué cántaro dejarías tú?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l18b", "text": "Dilo en una palabra.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
