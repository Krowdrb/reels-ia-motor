[
  {"id": "l01", "text": "Siete años vi a Jacob trabajar por Raquel…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "y la mañana de la boda, no era ella.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Le parecieron pocos días: la amaba.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Pero Labán le dio a su otra hija.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "Al amanecer… era Lea.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Tras la semana, recibió a Raquel…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "y sirvió otros siete años.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "Catorce años…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "veinte, lejos de casa.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Al volver, junto al Jaboc, quedó solo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Un varón luchó con él hasta el alba.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "No te dejaré, si no me bendices.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "Tu nombre ya no será Jacob, sino Israel.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14", "text": "Salió el sol. Cojeaba…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l15", "text": "pero bendecido.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l16", "text": "Hasta la noche más larga tiene alba.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l17", "text": "¿Tú sigues esperando la tuya?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
