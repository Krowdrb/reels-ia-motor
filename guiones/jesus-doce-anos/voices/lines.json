[
  {"id": "l01", "text": "Doce años tenía Jesús…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "y sus padres lo buscaron tres días.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Volvíamos de la Pascua.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Creían que él iba en la caravana.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "Un día de camino después…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "no estaba entre los parientes.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Tres días después lo hallaron en el templo,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "sentado entre los maestros, oyendo y preguntando.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "Todos se maravillaban.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Su madre: Hijo, ¿por qué nos hiciste esto?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Te buscábamos con angustia.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "¿Por qué me buscaban?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "¿No sabían que debo estar en las cosas de mi Padre?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14", "text": "No entendieron.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l15", "text": "Pero bajó con ellos, y les obedecía.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l16", "text": "Si lo buscas, empieza por las cosas del Padre.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l17", "text": "¿Dónde lo buscas tú?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
