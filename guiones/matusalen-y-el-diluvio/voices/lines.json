[
  {"id": "l01", "text": "Matusalén vivió novecientos sesenta y nueve años.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l01b", "text": "Estoy sentada a su lado.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "¿Sabes qué pasó el año en que murió?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "A los ciento ochenta y siete,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03b", "text": "tuvo a su hijo Lamec.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Lamec, a los ciento ochenta y dos,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04b", "text": "tuvo a Noé, y dijo:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04c", "text": "«este nos consolará».", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "Noé tenía seiscientos años", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05b", "text": "cuando llegó el diluvio.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Suma conmigo, con las cifras del texto:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06b", "text": "ciento ochenta y siete, más ciento ochenta y dos,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06c", "text": "más seiscientos…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Novecientos sesenta y nueve.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07b", "text": "Murió el mismo año del diluvio.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "La Biblia no dice cómo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "Dios esperó una vida entera.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09b", "text": "Su paciencia esperaba", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09c", "text": "mientras se preparaba el arca.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Y hoy también te espera a ti.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "¿Qué le dirías?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11b", "text": "Dilo en una palabra.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
