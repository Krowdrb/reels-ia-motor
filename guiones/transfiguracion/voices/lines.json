[
  {"id": "l01", "text": "Pedro vio a Jesús brillar como el sol…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "y junto a él, Moisés y Elías.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "Seis días después, cuenta Mateo,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03b", "text": "subimos a un monte alto.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Solo tres discípulos:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04b", "text": "Pedro, Santiago y Juan.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "Arriba, su ropa se volvió blanca como la luz.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Pedro, sin saber qué decir,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06b", "text": "propuso tres tiendas.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Aún hablaba…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07b", "text": "cuando una nube de luz los cubrió.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "Y una voz:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08b", "text": "Este es mi Hijo amado.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08c", "text": "A él oíd.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "Cayeron sobre sus rostros,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09b", "text": "con gran temor.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Pero Jesús se acercó, los tocó:", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10b", "text": "Levantaos, no temáis.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Y a nadie vieron,", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11b", "text": "sino a Jesús solo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "Bastaba oírlo a él.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "¿A quién oyes?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
