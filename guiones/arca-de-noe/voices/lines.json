[
  {"id": "a01", "text": "Estoy al pie del arca de Noé.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a02", "text": "Trescientos codos. ¿Qué tan grande es?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a03", "text": "Unos ciento treinta y cinco metros de largo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a04", "text": "Más que una cancha de fútbol.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a05", "text": "Veintidós metros de ancho.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a06", "text": "Trece de alto.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a07", "text": "Brea por dentro y por fuera.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a08", "text": "Tres pisos.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a09", "text": "Una ventana arriba, una puerta al costado.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a10", "text": "Y Noé tenía seiscientos años.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a11", "text": "Entraron ocho personas.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a12", "text": "Y el Señor cerró la puerta.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a13", "text": "Llovió cuarenta días y cuarenta noches.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a14", "text": "El agua cubrió la tierra ciento cincuenta días.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a15", "text": "Después, el arca reposó en los montes de Ararat.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a16", "text": "Una paloma trajo una hoja de olivo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a17", "text": "Y Dios puso su arco en las nubes.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a18", "text": "El arca era enorme.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a19", "text": "Pero la puerta la cerró Dios.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "a20", "text": "¿Qué cifra te sorprendió más?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
