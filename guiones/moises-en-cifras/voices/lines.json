[
  {"id": "l01", "text": "Moisés tenía ochenta años…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l02", "text": "y yo estaba con él.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l03", "text": "A los cuarenta, vivía en el palacio.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l04", "text": "Defendió a un hebreo…", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l05", "text": "mató a un egipcio y huyó.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l06", "text": "Cuarenta años fue pastor en Madián.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l07", "text": "Entonces vi la zarza.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l08", "text": "Ardía… y no se consumía.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l09", "text": "¡Moisés, Moisés!", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l10", "text": "Dios lo llamó así.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l11", "text": "Quítate el calzado: es tierra santa.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l12", "text": "Te envío al faraón.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l13", "text": "Con ochenta años, fue.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l14", "text": "Y guio a su pueblo cuarenta años.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l15", "text": "A los ciento veinte, subió al Nebo.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l16", "text": "Su vista seguía intacta.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l17", "text": "Vio la tierra prometida… y no entró.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l18", "text": "Nadie conoce su sepulcro.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l19", "text": "Para Dios, no era tarde.", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"},
  {"id": "l20", "text": "¿Para ti es tarde?", "voice": "ef_dora", "speed": 1.0, "lang": "es-419"}
]
